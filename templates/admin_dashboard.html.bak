{% extends "admin_base.html" %}
{% set active_page = "dashboard" %}

{% block title %}Admin Dashboard | NE Locals{% endblock %}
{% block page_title %}Admin Dashboard{% endblock %}

{% block content %}
{% set mode_ui = delivery_mode_ui|default({}) %}
{% set users_total = metrics.users|default(0) %}
{% set customers_total = metrics.customers|default(0) %}
{% set stores_total = metrics.stores|default(0) %}
{% set products_total = metrics.products|default(0) %}
{% set orders_total = metrics.orders|default(0) %}
{% set earnings_total = metrics.total_earnings|default(metrics.gmv|default(0)) %}
{% set gmv_total = metrics.gmv|default(0) %}
{% set delivery_people_total = metrics.delivery_people|default(0) %}
{% set active_delivery_people_total = metrics.active_delivery_people|default(0) %}
{% set unassigned_orders_total = metrics.unassigned_orders|default(0) %}
{% set accepted_delivery_total = metrics.accepted_by_delivery|default(0) %}
{% set packaging_orders_total = metrics.packaging_orders|default(0) %}
{% set out_for_delivery_total = metrics.out_for_delivery|default(0) %}
{% set delivered_orders_total = metrics.delivered_orders|default(0) %}
{% set cancelled_orders_total = metrics.cancelled_orders|default(0) %}
{% set refund_pending_total = metrics.refund_pending_count|default(0) %}
{% set admin_review_needed_total = metrics.admin_review_needed_count|default(0) %}
{% set refund_processed_total = metrics.refund_processed_count|default(0) %}
{% set ready_for_refund_amount = metrics.ready_for_refund_amount|default(0) %}
{% set refund_processed_amount = metrics.refund_processed_amount|default(0) %}
{% set store_refund_deduction_amount = metrics.store_refund_deduction_amount|default(0) %}
{% set store_adjustment_due_amount = metrics.store_adjustment_due_amount|default(0) %}
{% set online_payment_received_amount = metrics.online_payment_received_amount|default(0) %}
{% set online_payment_received_count = metrics.online_payment_received_count|default(0) %}
{% set cod_rider_cash_pending_amount = metrics.cod_rider_cash_pending_amount|default(0) %}
{% set cod_rider_cash_pending_count = metrics.cod_rider_cash_pending_count|default(0) %}
{% set platform_fee_received_amount = metrics.platform_fee_received_amount|default(0) %}
{% set store_payout_pending_amount = metrics.store_payout_pending_amount|default(0) %}
{% set store_payout_pending_count = metrics.store_payout_pending_count|default(0) %}

<section class="admin-clean-dashboard" data-page="admin-dashboard">
  <style>
    .admin-clean-dashboard{
      --ad-bg:#F8FFFB;
      --ad-card:#FFFFFF;
      --ad-soft:#F3FFF8;
      --ad-line:#DDECE4;
      --ad-line2:#EAF4EF;
      --ad-text:#1F332A;
      --ad-muted:#66756D;
      --ad-green:#00A859;
      --ad-green-dark:#008A48;
      --ad-orange:#FF8A1F;
      --ad-red:#B91C1C;
      --ad-blue:#0284C7;
      --ad-shadow:0 14px 36px rgba(17,64,38,.08);
      width:100%;
      display:grid;
      gap:18px;
      color:var(--ad-text);
    }
    .admin-clean-dashboard *{box-sizing:border-box;}
    .ad-hero{
      display:grid;
      grid-template-columns:minmax(0,1.35fr) minmax(310px,.65fr);
      gap:16px;
      align-items:stretch;
      padding:20px;
      border:1px solid rgba(0,168,89,.18);
      border-radius:26px;
      background:linear-gradient(135deg,#F3FFF8 0%,#FFFFFF 58%,#FFFDF8 100%);
      box-shadow:var(--ad-shadow);
      overflow:hidden;
    }
    .ad-kicker{
      width:max-content;
      max-width:100%;
      min-height:30px;
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:0 12px;
      border-radius:999px;
      background:#fff;
      border:1px solid rgba(0,168,89,.16);
      color:var(--ad-green-dark);
      font-size:12px;
      font-weight:950;
      letter-spacing:.07em;
      text-transform:uppercase;
    }
    .ad-title{
      margin:12px 0 7px;
      font-size:clamp(1.35rem,2.3vw,2rem);
      line-height:1.08;
      font-weight:950;
      letter-spacing:-.04em;
      color:var(--ad-text);
    }
    .ad-copy{
      margin:0;
      color:var(--ad-muted);
      font-size:.92rem;
      line-height:1.55;
      font-weight:720;
    }
    .ad-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;}
    .ad-btn{
      min-height:42px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:0 14px;
      border-radius:15px;
      border:1px solid rgba(0,168,89,.20);
      background:#fff;
      color:var(--ad-green-dark);
      font-size:.84rem;
      font-weight:950;
      text-decoration:none;
      transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .ad-btn:hover{transform:translateY(-1px);box-shadow:0 12px 24px rgba(0,168,89,.12);border-color:rgba(0,168,89,.34);}
    .ad-btn.primary{background:var(--ad-green);border-color:var(--ad-green);color:#fff;box-shadow:0 12px 24px rgba(0,168,89,.18);}
    .ad-mode-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}
    .ad-mode-mini{
      min-height:112px;
      padding:14px;
      border-radius:20px;
      border:1px solid rgba(0,168,89,.13);
      background:#fff;
      display:grid;
      align-content:center;
      gap:6px;
    }
    .ad-mode-mini span{color:var(--ad-muted);font-size:.68rem;font-weight:950;text-transform:uppercase;letter-spacing:.06em;}
    .ad-mode-mini strong{font-size:1.22rem;line-height:1.05;font-weight:950;color:var(--ad-text);}
    .ad-mode-mini small{color:var(--ad-muted);font-size:.78rem;line-height:1.35;font-weight:720;}
    .ad-section{
      border:1px solid var(--ad-line);
      border-radius:24px;
      background:var(--ad-card);
      box-shadow:var(--ad-shadow);
      overflow:hidden;
    }
    .ad-section-head{
      min-height:60px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      padding:16px 18px;
      border-bottom:1px solid var(--ad-line2);
      background:linear-gradient(180deg,#FFFFFF,#FBFFFD);
    }
    .ad-section-head h2{margin:0;font-size:1rem;font-weight:950;letter-spacing:-.025em;color:var(--ad-text);}
    .ad-section-head p{margin:4px 0 0;color:var(--ad-muted);font-size:.8rem;font-weight:700;line-height:1.35;}
    .ad-section-link{color:var(--ad-green-dark);font-size:.8rem;font-weight:950;text-decoration:none;white-space:nowrap;}
    .ad-body{padding:18px;}
    .ad-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;}
    .ad-kpi{
      min-height:136px;
      padding:16px;
      border-radius:20px;
      border:1px solid var(--ad-line2);
      background:linear-gradient(180deg,#fff,#FBFFFD);
      display:grid;
      align-content:space-between;
      gap:10px;
    }
    .ad-kpi-top{display:flex;align-items:center;justify-content:space-between;gap:10px;}
    .ad-icon{width:42px;height:42px;min-width:42px;border-radius:16px;display:grid;place-items:center;background:var(--ad-soft);color:var(--ad-green-dark);font-size:1.22rem;border:1px solid rgba(0,168,89,.13);}
    .ad-kpi small{color:var(--ad-muted);font-size:.72rem;font-weight:950;text-transform:uppercase;letter-spacing:.055em;line-height:1.35;}
    .ad-kpi strong{display:block;margin-top:6px;color:var(--ad-text);font-size:1.55rem;line-height:1;font-weight:950;letter-spacing:-.035em;}
    .ad-kpi p{margin:0;color:var(--ad-muted);font-size:.78rem;line-height:1.35;font-weight:720;}
    .ad-kpi.warn .ad-icon{background:#FFF7E8;color:#A84700;border-color:rgba(255,138,31,.18);}
    .ad-kpi.danger .ad-icon{background:#FFF1F2;color:var(--ad-red);border-color:rgba(185,28,28,.14);}
    .ad-kpi.blue .ad-icon{background:#EFF8FF;color:var(--ad-blue);border-color:rgba(2,132,199,.16);}
    .ad-grid-2{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);gap:16px;}
    .ad-chart{height:300px;min-height:300px;width:100%;}
    .ad-list{display:grid;gap:10px;}
    .ad-row{
      min-height:58px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:10px 0;
      border-bottom:1px solid var(--ad-line2);
    }
    .ad-row:last-child{border-bottom:0;}
    .ad-row-left{display:flex;align-items:center;gap:10px;min-width:0;}
    .ad-thumb{width:42px;height:42px;min-width:42px;border-radius:15px;background:var(--ad-soft);border:1px solid rgba(0,168,89,.13);display:grid;place-items:center;overflow:hidden;color:var(--ad-green-dark);font-weight:900;}
    .ad-thumb img{width:100%;height:100%;object-fit:cover;}
    .ad-name{font-size:.88rem;font-weight:900;color:var(--ad-text);line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px;}
    .ad-meta{margin-top:3px;color:var(--ad-muted);font-size:.74rem;font-weight:720;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px;}
    .ad-pill{min-width:76px;display:inline-flex;align-items:center;justify-content:center;padding:8px 10px;border-radius:999px;background:var(--ad-soft);color:var(--ad-green-dark);font-size:.75rem;font-weight:950;white-space:nowrap;}
    .ad-table-wrap{overflow:auto;}
    .ad-table{width:100%;min-width:720px;border-collapse:collapse;}
    .ad-table th{padding:12px 14px;text-align:left;background:#F3FFF8;color:var(--ad-green-dark);font-size:.72rem;font-weight:950;text-transform:uppercase;letter-spacing:.07em;border-bottom:1px solid var(--ad-line);}
    .ad-table td{padding:13px 14px;border-bottom:1px solid var(--ad-line2);color:var(--ad-text);font-size:.84rem;font-weight:750;}
    .ad-empty{padding:16px;border:1px dashed var(--ad-line);border-radius:18px;background:#FBFFFD;color:var(--ad-muted);font-size:.84rem;font-weight:760;text-align:center;}
    .ad-quick-links{display:flex;flex-wrap:wrap;gap:10px;}
    .ad-footer-note{color:var(--ad-muted);font-size:.78rem;font-weight:700;padding:2px 0 0;}
    @media(max-width:1280px){.ad-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr));}.ad-grid-2{grid-template-columns:1fr;}}
    @media(max-width:980px){.ad-hero{grid-template-columns:1fr;}.ad-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
    @media(max-width:640px){.ad-hero,.ad-body{padding:14px;}.ad-mode-grid,.ad-kpi-grid{grid-template-columns:1fr;}.ad-actions,.ad-quick-links{display:grid;grid-template-columns:1fr;}.ad-btn{width:100%;}.ad-section-head{align-items:flex-start;flex-direction:column;}.ad-row{align-items:flex-start;}.ad-name,.ad-meta{max-width:170px;}}
  </style>

  <section class="ad-hero" aria-label="Delivery mode and admin summary">
    <div>
      <span class="ad-kicker">{{ mode_ui.get('icon', '🚚') }} {{ mode_ui.get('label', 'Delivery Mode') }}</span>
      <h1 class="ad-title">{{ mode_ui.get('admin_dashboard_title', 'Admin operations dashboard') }}</h1>
      <p class="ad-copy">{{ mode_ui.get('admin_dashboard_copy', 'Manage live orders, stores, payments and delivery settings from one clean admin console.') }}</p>
      <div class="ad-actions">
        <a class="ad-btn primary" href="{{ url_for('admin_delivery_mode_settings') }}">Delivery Routing Settings</a>
        <a class="ad-btn" href="{{ url_for('admin_store_overview') }}">Store Overview</a>
        <a class="ad-btn" href="{{ url_for('admin_settlements') }}">Settlements</a>
        {% if return_refund_enabled %}<a class="ad-btn" href="{{ url_for('admin_refund_processing') }}">Refunds</a>{% endif %}
      </div>
    </div>
    <div class="ad-mode-grid">
      <div class="ad-mode-mini">
        <span>Provider</span>
        <strong>{{ mode_ui.get('provider_label', 'NE Locals') }}</strong>
        <small>{{ mode_ui.get('provider_type', 'Delivery') }}</small>
      </div>
      <div class="ad-mode-mini">
        <span>Payment Rule</span>
        <strong>{{ mode_ui.get('payment_rule_label', 'Configured') }}</strong>
        <small>{% if mode_ui.get('online_only') %}Online only{% elif mode_ui.get('cod_allowed') and mode_ui.get('online_allowed') %}COD + online allowed{% elif mode_ui.get('cod_allowed') %}COD allowed{% else %}Online enabled{% endif %}</small>
      </div>
      <div class="ad-mode-mini">
        <span>Order Value</span>
        <strong>₹ {{ '%.2f'|format(gmv_total|float) }}</strong>
        <small>Delivered order GMV</small>
      </div>
      <div class="ad-mode-mini">
        <span>Stores</span>
        <strong>{{ stores_total }}</strong>
        <small>Active store records</small>
      </div>
    </div>
  </section>

  <section class="ad-section">
    <div class="ad-section-head">
      <div>
        <h2>Core business summary</h2>
        <p>Only current live counts are shown. Static “newly added” placeholders were removed.</p>
      </div>
      <a class="ad-section-link" href="{{ url_for('admin_exports') }}">Exports</a>
    </div>
    <div class="ad-body">
      <div class="ad-kpi-grid">
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Orders</small><span class="ad-icon">🛒</span></div><strong>{{ orders_total }}</strong><p>Total order records</p></article>
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Products</small><span class="ad-icon">🛍️</span></div><strong>{{ products_total }}</strong><p>Product catalog records</p></article>
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Stores</small><span class="ad-icon">🏪</span></div><strong>{{ stores_total }}</strong><p>Store admin profiles</p></article>
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Customers</small><span class="ad-icon">👥</span></div><strong>{{ customers_total }}</strong><p>Customer accounts</p></article>
        <article class="ad-kpi blue"><div class="ad-kpi-top"><small>Online collections</small><span class="ad-icon">💳</span></div><strong>₹ {{ '%.2f'|format(online_payment_received_amount|float) }}</strong><p>{{ online_payment_received_count }} online paid orders</p></article>
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Platform fee</small><span class="ad-icon">📈</span></div><strong>₹ {{ '%.2f'|format(platform_fee_received_amount|float) }}</strong><p>Platform fee received</p></article>
        <article class="ad-kpi warn"><div class="ad-kpi-top"><small>Store payout pending</small><span class="ad-icon">🏦</span></div><strong>₹ {{ '%.2f'|format(store_payout_pending_amount|float) }}</strong><p>{{ store_payout_pending_count }} payouts pending</p></article>
        {% if in_house_delivery_enabled %}
        <article class="ad-kpi warn"><div class="ad-kpi-top"><small>COD rider cash</small><span class="ad-icon">🧾</span></div><strong>₹ {{ '%.2f'|format(cod_rider_cash_pending_amount|float) }}</strong><p>{{ cod_rider_cash_pending_count }} settlements pending</p></article>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="ad-section">
    <div class="ad-section-head">
      <div>
        <h2>Order workflow</h2>
        <p>Delivery-specific buttons and cards are displayed only when that mode is active.</p>
      </div>
      {% if in_house_delivery_enabled %}
        <a class="ad-section-link" href="{{ url_for('admin_delivery_overview') }}">Delivery overview</a>
      {% elif third_party_shipping_enabled %}
        <a class="ad-section-link" href="{{ url_for('admin_external_delivery_orders') }}">Courier orders</a>
      {% else %}
        <a class="ad-section-link" href="{{ url_for('admin_delivery_mode_settings') }}">Routing settings</a>
      {% endif %}
    </div>
    <div class="ad-body">
      <div class="ad-kpi-grid">
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Placed / confirmed</small><span class="ad-icon">🧾</span></div><strong>{{ unassigned_orders_total }}</strong><p>New orders needing next action</p></article>
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Preparing</small><span class="ad-icon">📦</span></div><strong>{{ packaging_orders_total }}</strong><p>Store packaging/preparing</p></article>
        {% if in_house_delivery_enabled %}
          <article class="ad-kpi"><div class="ad-kpi-top"><small>Assigned</small><span class="ad-icon">🛵</span></div><strong>{{ accepted_delivery_total }}</strong><p>With in-house delivery staff</p></article>
          <article class="ad-kpi blue"><div class="ad-kpi-top"><small>Out for delivery</small><span class="ad-icon">🚚</span></div><strong>{{ out_for_delivery_total }}</strong><p>Live in-house deliveries</p></article>
          <article class="ad-kpi"><div class="ad-kpi-top"><small>Delivery staff</small><span class="ad-icon">👷</span></div><strong>{{ delivery_people_total }}</strong><p>{{ active_delivery_people_total }} active staff accounts</p></article>
        {% elif third_party_shipping_enabled %}
          <article class="ad-kpi blue"><div class="ad-kpi-top"><small>Courier mode</small><span class="ad-icon">📮</span></div><strong>Active</strong><p>Shiprocket/courier operations enabled</p></article>
          <article class="ad-kpi"><div class="ad-kpi-top"><small>Tracking</small><span class="ad-icon">🔎</span></div><strong>AWB</strong><p>Use courier orders for tracking updates</p></article>
        {% else %}
          <article class="ad-kpi blue"><div class="ad-kpi-top"><small>External local</small><span class="ad-icon">⚡</span></div><strong>Active</strong><p>Uses NE Locals order reference</p></article>
          <article class="ad-kpi"><div class="ad-kpi-top"><small>Delivery staff</small><span class="ad-icon">—</span></div><strong>Hidden</strong><p>In-house delivery screens are not shown</p></article>
        {% endif %}
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Delivered</small><span class="ad-icon">✅</span></div><strong>{{ delivered_orders_total }}</strong><p>Completed orders</p></article>
        <article class="ad-kpi danger"><div class="ad-kpi-top"><small>Cancelled</small><span class="ad-icon">✕</span></div><strong>{{ cancelled_orders_total }}</strong><p>Cancelled order records</p></article>
      </div>
    </div>
  </section>

  {% if return_refund_enabled %}
  <section class="ad-section">
    <div class="ad-section-head">
      <div>
        <h2>Returns, refunds and adjustment work</h2>
        <p>Hidden automatically when the return/refund module is disabled.</p>
      </div>
      <a class="ad-section-link" href="{{ url_for('admin_refund_processing') }}">Open refunds</a>
    </div>
    <div class="ad-body">
      <div class="ad-kpi-grid">
        <article class="ad-kpi warn"><div class="ad-kpi-top"><small>Refunds pending</small><span class="ad-icon">⏳</span></div><strong>{{ refund_pending_total }}</strong><p>₹ {{ '%.2f'|format(ready_for_refund_amount|float) }} waiting</p></article>
        <article class="ad-kpi danger"><div class="ad-kpi-top"><small>Admin review</small><span class="ad-icon">⚠️</span></div><strong>{{ admin_review_needed_total }}</strong><p>Return/refund decisions pending</p></article>
        <article class="ad-kpi"><div class="ad-kpi-top"><small>Processed</small><span class="ad-icon">✅</span></div><strong>{{ refund_processed_total }}</strong><p>₹ {{ '%.2f'|format(refund_processed_amount|float) }} processed</p></article>
        <article class="ad-kpi warn"><div class="ad-kpi-top"><small>Store deduction</small><span class="ad-icon">🏪</span></div><strong>₹ {{ '%.2f'|format(store_refund_deduction_amount|float) }}</strong><p>Deducted from store payout</p></article>
        <article class="ad-kpi danger"><div class="ad-kpi-top"><small>Adjustment due</small><span class="ad-icon">🧾</span></div><strong>₹ {{ '%.2f'|format(store_adjustment_due_amount|float) }}</strong><p>Recover from next payout</p></article>
      </div>
    </div>
  </section>
  {% endif %}

  <section class="ad-grid-2">
    <div class="ad-section">
      <div class="ad-section-head">
        <div><h2>Gross order value</h2><p>Monthly delivered order value.</p></div>
        <span class="ad-section-link">₹ {{ '%.2f'|format(gmv_total|float) }}</span>
      </div>
      <div class="ad-body"><div class="ad-chart" id="adminGrossSaleChart"></div></div>
    </div>

    <div class="ad-section">
      <div class="ad-section-head"><div><h2>User mix</h2><p>Clean account split.</p></div></div>
      <div class="ad-body">
        <div class="ad-list">
          <div class="ad-row"><div class="ad-row-left"><span class="ad-thumb">👥</span><div><div class="ad-name">Customers</div><div class="ad-meta">Customer login accounts</div></div></div><span class="ad-pill">{{ customers_total }}</span></div>
          <div class="ad-row"><div class="ad-row-left"><span class="ad-thumb">🏪</span><div><div class="ad-name">Stores</div><div class="ad-meta">Store admin records</div></div></div><span class="ad-pill">{{ stores_total }}</span></div>
          {% if in_house_delivery_enabled %}<div class="ad-row"><div class="ad-row-left"><span class="ad-thumb">🛵</span><div><div class="ad-name">Delivery staff</div><div class="ad-meta">In-house accounts only</div></div></div><span class="ad-pill">{{ delivery_people_total }}</span></div>{% endif %}
          <div class="ad-row"><div class="ad-row-left"><span class="ad-thumb">🛡️</span><div><div class="ad-name">Admin/Staff Users</div><div class="ad-meta">All user records</div></div></div><span class="ad-pill">{{ users_total }}</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="ad-section">
    <div class="ad-section-head">
      <div><h2>Store performance</h2><p>Revenue-first store overview.</p></div>
      <a class="ad-section-link" href="{{ url_for('admin_store_overview') }}">View store dashboard</a>
    </div>
    <div class="ad-body ad-table-wrap">
      <table class="ad-table" id="adminStoresTable">
        <thead><tr><th>Store</th><th>Orders</th><th>Delivered</th><th>Revenue</th><th>Rating</th></tr></thead>
        <tbody>
          {% for s in by_store|default([]) %}
            <tr {% if s.store_id %}data-store-id="{{ s.store_id }}"{% endif %}>
              <td>{{ s.store_name|default('Store') }}</td>
              <td>{{ s.orders|default(0) }}</td>
              <td>{{ s.delivered_orders|default(0) }}</td>
              <td>₹ {{ '%.2f'|format(s.revenue|default(0)|float) }}</td>
              <td class="rating-cell">—</td>
            </tr>
          {% else %}
            <tr><td colspan="5"><div class="ad-empty">No store performance found.</div></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ad-grid-2">
    <div class="ad-section">
      <div class="ad-section-head"><div><h2>Top products</h2><p>Best selling product records.</p></div></div>
      <div class="ad-body ad-list">
        {% set selling_items = top_selling_items|default([]) %}
        {% for p in selling_items[:6] %}
          <div class="ad-row"><div class="ad-row-left"><span class="ad-thumb">{% if p.image_url %}<img src="{{ p.image_url }}" alt="{{ p.product_name|default('Item') }}">{% else %}🛍️{% endif %}</span><div><div class="ad-name">{{ p.product_name|default('Item') }}</div><div class="ad-meta">₹ {{ '%.2f'|format(p.revenue|default(0)|float) }} revenue</div></div></div><span class="ad-pill">{{ p.sold|default(0) }} sold</span></div>
        {% else %}<div class="ad-empty">No selling items found.</div>{% endfor %}
      </div>
    </div>

    <div class="ad-section">
      <div class="ad-section-head"><div><h2>Customer complaints</h2><p>Store and delivery complaint signals.</p></div><a class="ad-section-link" href="{{ url_for('admin_complaints') }}">Open</a></div>
      <div class="ad-body ad-list">
        {% set store_complaints = top_store_complaints|default([]) %}
        {% for s in store_complaints[:3] %}
          <div class="ad-row"><div class="ad-row-left"><span class="ad-thumb">🏬</span><div><div class="ad-name">{{ s.store_name or ('ID ' ~ s.store_id) }}</div><div class="ad-meta">Store-related complaints</div></div></div><span class="ad-pill">{{ s.cnt|default(0) }}</span></div>
        {% endfor %}
        {% if in_house_delivery_enabled %}
          {% set delivery_complaints = top_delivery_complaints|default([]) %}
          {% for d in delivery_complaints[:3] %}
            <div class="ad-row"><div class="ad-row-left"><span class="ad-thumb">🚚</span><div><div class="ad-name">{{ d.delivery_name or d.name or ('ID ' ~ d.user_id) }}</div><div class="ad-meta">Delivery complaint</div></div></div><span class="ad-pill">{{ d.cnt|default(0) }}</span></div>
          {% endfor %}
        {% endif %}
        {% if not store_complaints and (not in_house_delivery_enabled or not delivery_complaints|default([])) %}<div class="ad-empty">No complaint summary found.</div>{% endif %}
      </div>
    </div>
  </section>

  <section class="ad-section">
    <div class="ad-section-head">
      <div><h2>Admin quick actions</h2><p>Mode-aware shortcuts only. Disabled-mode pages are not shown.</p></div>
    </div>
    <div class="ad-body">
      <div class="ad-quick-links">
        {% for link in quick_links|default([]) %}
          <a class="ad-btn" href="{{ url_for(link.endpoint) }}">{{ link.label }}</a>
        {% else %}
          <a class="ad-btn" href="{{ url_for('admin_store_overview') }}">Store Overview</a>
          <a class="ad-btn" href="{{ url_for('admin_delivery_mode_settings') }}">Delivery Settings</a>
          <a class="ad-btn" href="{{ url_for('admin_settlements') }}">Settlements</a>
          {% if return_refund_enabled %}<a class="ad-btn" href="{{ url_for('admin_refund_processing') }}">Refunds</a>{% endif %}
        {% endfor %}
      </div>
      <p class="ad-footer-note">Admin dashboard uses the same delivery-mode visibility rules as the store panel.</p>
    </div>
  </section>

  <script>
    (function(){
      const el = document.getElementById('adminGrossSaleChart');
      if (!el) return;
      const labels = {{ sales_labels|default([])|tojson }};
      const values = {{ sales_values|default([])|tojson }}.map(function(v){ return Number(v || 0); });
      const safeLabels = labels.length ? labels : ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const safeValues = values.length ? values : new Array(safeLabels.length).fill(0);
      const width = 1000, height = 300, padL = 50, padR = 20, padT = 20, padB = 38;
      const innerW = width - padL - padR, innerH = height - padT - padB;
      const maxV = Math.max.apply(null, safeValues.concat([1]));
      const stepX = safeValues.length > 1 ? innerW / (safeValues.length - 1) : innerW;
      const pts = safeValues.map(function(v,i){ return [padL + i * stepX, padT + innerH - ((v / maxV) * innerH)]; });
      const path = pts.map(function(p,i){ return (i ? 'L ' : 'M ') + p[0] + ' ' + p[1]; }).join(' ');
      const area = pts.length ? path + ' L ' + (padL + innerW) + ' ' + (padT + innerH) + ' L ' + padL + ' ' + (padT + innerH) + ' Z' : '';
      const grid = [0,.25,.5,.75,1].map(function(frac){ const y = padT + innerH - innerH * frac; return '<line x1="'+padL+'" y1="'+y+'" x2="'+(padL+innerW)+'" y2="'+y+'" stroke="#EAF4EF"/>'; }).join('');
      const xLabels = safeLabels.map(function(label,i){ const x = padL + i * stepX; return '<text x="'+x+'" y="'+(height-10)+'" text-anchor="middle" fill="#66756D" font-size="12" font-family="Inter, Arial">'+String(label).slice(0,3)+'</text>'; }).join('');
      el.innerHTML = '<svg viewBox="0 0 '+width+' '+height+'" width="100%" height="100%" preserveAspectRatio="none" role="img" aria-label="Gross order value chart"><defs><linearGradient id="adFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#00A859" stop-opacity=".26"/><stop offset="100%" stop-color="#00A859" stop-opacity=".03"/></linearGradient></defs><rect width="'+width+'" height="'+height+'" fill="#fff"/>'+grid+'<path d="'+area+'" fill="url(#adFill)"/><path d="'+path+'" fill="none" stroke="#00A859" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>'+xLabels+'</svg>';
    })();

    (async function(){
      const rows = document.querySelectorAll('#adminStoresTable tbody tr[data-store-id]');
      if (!rows.length) return;
      for (const tr of rows) {
        const sid = tr.getAttribute('data-store-id');
        const cell = tr.querySelector('.rating-cell');
        if (!sid || !cell) continue;
        try {
          const res = await fetch('/api/ratings/store/' + encodeURIComponent(sid), { cache: 'no-store' });
          if (!res.ok) continue;
          const data = await res.json();
          if (!data || !data.ok) continue;
          const avg = Number(data.avg || 0);
          const count = Number(data.count || 0);
          const filled = Math.max(0, Math.min(5, Math.floor(avg)));
          cell.innerHTML = '<span style="color:#00A859;font-weight:950;letter-spacing:1px;">' + '★'.repeat(filled).padEnd(5, '☆') + '</span> <span style="color:#8A9890;">(' + count + ')</span>';
        } catch (_) {}
      }
    })();
  </script>
</section>
{% endblock %}
