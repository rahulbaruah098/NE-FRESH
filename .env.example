# =============================================================
# NE FRESH / NE LOCALS - CURRENT ENVIRONMENT SCHEMA
# Copy to .env for local development only. Never commit real secrets.
# Production should store its real environment outside the Git checkout.
# =============================================================

# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
PORT=5000
FLASK_DEBUG=0
NEFRESH_AUTO_RELOAD=0
NEFRESH_DEBUG_LOGS=0

# Browser session / CSRF
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
ENABLE_CSRF_PROTECTION=1


# Reverse proxy trust (leave disabled for direct local Flask execution)
TRUST_PROXY_HEADERS=0
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
PROXY_FIX_X_HOST=0
PROXY_FIX_X_PORT=0
PROXY_FIX_X_PREFIX=0

# MongoDB - URI must include a database name
MONGO_URI=mongodb://localhost:27017/NE_Fresh
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000

# API CORS - comma-separated exact origins
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Runtime media
# Production: use an absolute persistent path outside the release directory,
# for example /var/lib/nefresh/uploads. S3 migration is a later deployment step.
UPLOAD_FOLDER=./uploads

# Site / support
APP_BRAND_NAME=NELOCALS
SUPPORT_EMAIL=support@nelocals.in
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=

# SMTP / email / OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=NELOCALS

# Razorpay - configure the pair for the mode enabled by Admin payment settings
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=


# Optional production Shiprocket runtime secret overrides.
# When set, these take priority over legacy Mongo-stored secrets.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# Optional one-time admin bootstrap.
# Run: python scripts/init_db.py
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrator
ADMIN_SEED_PHONE=
