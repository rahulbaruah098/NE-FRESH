# NE FRESH production environment for /etc/nefresh/nefresh.env
# NEVER commit a real copy of this file with secrets.

APP_ENV=production
APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FLASK_DEBUG=0
NEFRESH_AUTO_RELOAD=0
NEFRESH_DEBUG_LOGS=0

# Session/cookie security behind HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
ENABLE_CSRF_PROTECTION=true

# Nginx is the single trusted proxy directly in front of Gunicorn.
TRUST_PROXY_HEADERS=true
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1
PROXY_FIX_X_PREFIX=0

# Exact production web/app origins only. Do not use * with credentialed requests.
CORS_ORIGINS=https://example.com,https://www.example.com

# MongoDB / Atlas. Use a least-privilege application user.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/NE_Fresh?retryWrites=true&w=majority
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000

# Persistent EBS-backed path outside versioned release directories.
UPLOAD_FOLDER=/srv/nefresh/shared/uploads

# Gunicorn: start conservatively; tune after staging load observation.
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# SMTP / OTP / password recovery - Gmail / Google Workspace App Password.
# Keep the real App Password only in /etc/nefresh/nefresh.env on the EC2 server.
# Do not commit it, paste it into source code, store it in MongoDB, or share it in chat.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=NE FRESH
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_DEBUG=false

# Razorpay - populate the LIVE pair only when live online payment is enabled.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# Shiprocket runtime secrets. These override legacy Mongo-stored secrets.
# Non-secret pickup/channel settings remain managed from Admin Settings.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# Optional deployment backup hook. In production, point to an executable that
# creates/verifies an Atlas snapshot or mongodump before database initialization.
BACKUP_HOOK=
REQUIRE_BACKUP_HOOK=0

# Optional one-time admin seed. Remove from the environment after initialization.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
